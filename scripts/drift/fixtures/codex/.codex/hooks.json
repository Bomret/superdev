{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<plugin-root>/hooks/update-check.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<plugin-root>/hooks/merge-guard.js\""
          },
          {
            "type": "command",
            "command": "node \"<plugin-root>/hooks/run-lock.js\""
          },
          {
            "type": "command",
            "command": "node \"<plugin-root>/hooks/ledger-guard.js\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<plugin-root>/hooks/ledger-guard.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<plugin-root>/hooks/green-gate.js\"",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<plugin-root>/hooks/slicetree-sweep.js\""
          },
          {
            "type": "command",
            "command": "node \"<plugin-root>/hooks/scope-prune.js\""
          }
        ]
      }
    ]
  }
}
